# Copy to .env.local for local development.

# Base URL the pmtiles protocol resolves tile/detail URLs against.
# Local dev (default): served from public/dev-tiles/ via `npm run generate:fixtures`.
# Staging/prod: point this at the Vercel Blob / R2 base URL instead (ADR 0001
# item 8) — nothing else in the frontend should need to change (ADR 0002).
NEXT_PUBLIC_TILES_BASE_URL=/dev-tiles
